{
  "manifest_version": 3,
  "name": "ChatGPT Tidy · 整理助手",
  "version": "0.3.8",
  "description": "当前对话问题目录，以及可恢复的 Projects 本地隐藏。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/Chelics/chatgpt-tidy"
}
